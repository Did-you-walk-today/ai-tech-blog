  "key_facts": [
    {
      "fact": "The official MCP registry held 22,117 servers with a latest version on 2026-08-17: 21,867 active and 250 deprecated",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "data"
    },
    {
      "fact": "Of the top 100 servers by GitHub stars, 74 have a namespace matching the repository owner, 4 do not, and 22 use domain namespaces that cannot be checked mechanically",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "data"
    },
    {
      "fact": "The rank-4 entry io.github.IncorporatedPartners/labelhead-artist-momentum, a hip-hop analytics server, declares the unrelated repository paperclipai/paperclip and inherits its 78,598 stars",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "case_study"
    },
    {
      "fact": "65 of the top 100 servers by stars declare a repository that is not dedicated to the MCP server (repository name lacks 'mcp'); their median star count is 6,250 versus 4,081 for the 35 dedicated repositories",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "data"
    },
    {
      "fact": "2,575 of 17,540 declared repositories (14.7%) returned no public response when queried",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "data"
    },
    {
      "fact": "4,577 servers (20.7% of the registry) declare no repository at all and cannot appear in any star-based ranking",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "data"
    },
    {
      "fact": "A single namespace, io.github.pipeworx-io, holds 1,312 servers — 5.93% of the registry; the top ten hold 12.44%",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "data"
    },
    {
      "fact": "Monthly registrations rose from 351 in September 2025 to 5,411 in July 2026, a 15x increase over ten months",
      "source": "jsonhouse original measurement, 2026-08-17",
      "category": "trend"
    },
    {
      "fact": "The MCP registry verifies namespace ownership via GitHub OAuth or a DNS TXT record but does not verify the repository URL; the publishing token requires no repository scopes because the registry never reads publisher code",
      "source": "MCP Registry authentication documentation, retrieved 2026-08-17",
      "category": "policy"
    },
    {
      "fact": "The registry's moderation policy states that it does not guarantee moderation, that consumers should assume minimal-to-no moderation, and that consumers should treat scraped data accordingly",
      "source": "MCP Registry moderation policy, retrieved 2026-08-17",
      "category": "policy"
    }
  ],
  "faq_summary": [
    {
      "q": "How many MCP servers exist in the official registry?",
      "a": "22,117 servers had a latest version on 2026-08-17 — 21,867 active and 250 deprecated. Counts near 9,000 from earlier in 2026 are stale."
    },
    {
      "q": "Does the MCP registry verify that a server owns the repository it links to?",
      "a": "No. It verifies the namespace via GitHub OAuth or a DNS TXT record, but the repository URL is self-declared. The publishing token needs no repository scopes because the registry never reads your code."
    },
    {
      "q": "Does a namespace-repository mismatch mean the server is fraudulent?",
      "a": "No. Mismatch only means the namespace owner and the repository owner are different strings, and an ownership transfer produces that difference honestly. It is a prompt to check the specific entry, not a verdict."
    },
    {
      "q": "Why do MCP server rankings disagree with each other?",
      "a": "Most rank on stars read from the repository field without checking ownership, and 20.7% of the registry declares no repository at all and drops out of such rankings entirely."
    },
    {
      "q": "How often is this ranking updated?",
      "a": "Every Monday. The full registry is swept, GitHub stars are re-joined, and the table and changelog are updated in place at the same URL."
    }
  ],
